<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'gs-head' %}
    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
