{%- comment -%}
  Gospelscribe password page: the lamp, a drop countdown, and a Klaviyo signup.
  Signups go straight to a Klaviyo list through Klaviyo's public "client subscriptions" API
  (only the public site key and list ID are used, no private keys).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign launch = s.launch_date | append: 'T' | append: s.launch_time | append: ':00' | append: s.utc_offset
-%}
<style>
  .gs-pw{position:relative;min-height:100vh;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:calc(80px + env(safe-area-inset-top,0px)) 20px calc(96px + env(safe-area-inset-bottom,0px));overflow:hidden;isolation:isolate}
  .gs-pw__bg{position:absolute;inset:0;z-index:-2;overflow:hidden;background:radial-gradient(ellipse at 50% 58%,rgba(230,176,90,.45),rgba(120,70,25,.18) 25%,transparent 55%),#0D0A08}
  .gs-pw__bg img{width:100%;height:100%;object-fit:cover;transform:scale(1.04)}
  .gs-pw::after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at center,rgba(0,0,0,{{ s.overlay | divided_by: 300.0 }}),rgba(0,0,0,{{ s.overlay | divided_by: 100.0 }}) 75%)}
  .gs-pw__glow{position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 50% 55%,rgba(255,190,100,.16),transparent 45%);animation:gs-pw-flicker 3.2s infinite}
  @keyframes gs-pw-flicker{0%,100%{opacity:.85}20%{opacity:1}35%{opacity:.7}50%{opacity:.95}72%{opacity:.8}}
  .gs-pw__logo{position:absolute;top:calc(22px + env(safe-area-inset-top,0px));left:0;right:0;display:flex;justify-content:center}
  .gs-pw__logo img{height:{{ s.logo_h }}px;width:auto}
  .gs-pw__word{font-family:var(--gs-display);font-size:1.6rem;color:var(--gs-parch)}
  .gs-pw__inner{width:100%;max-width:640px;opacity:0;animation:gs-pw-rise 1.4s ease .2s forwards}
  @keyframes gs-pw-rise{to{opacity:1}}
  .gs-pw h1{font-family:var(--gs-display);font-size:clamp(2.8rem,11vw,5.6rem);line-height:.98;text-shadow:0 2px 30px rgba(0,0,0,.8)}
  .gs-pw__tag{font-family:var(--gs-display);font-style:italic;color:var(--gs-gold-hi);font-size:clamp(1.15rem,3.4vw,1.5rem);margin-top:12px!important}
  .gs-pw__cd{display:flex;justify-content:center;gap:clamp(10px,3vw,26px);margin:34px 0 8px}
  .gs-pw__unit{min-width:64px}
  .gs-pw__num{display:block;font-family:var(--gs-display);font-size:clamp(2.6rem,11vw,4.6rem);line-height:1;color:var(--gs-parch);font-variant-numeric:tabular-nums}
  .gs-pw__lbl{display:block;margin-top:6px;font-family:var(--gs-caps);letter-spacing:.12em;font-size:.82rem;color:var(--gs-gold)}
  .gs-pw__sep{font-family:var(--gs-display);font-size:clamp(2rem,8vw,3.4rem);line-height:1;color:var(--gs-bronze);padding-top:4px}
  .gs-pw__when{font-family:var(--gs-caps);letter-spacing:.08em;color:var(--gs-parch-dim);font-size:.95rem}
  .gs-pw__open{display:none;margin:28px 0 8px}
  .gs-pw.is-open .gs-pw__cd,.gs-pw.is-open .gs-pw__when{display:none}
  .gs-pw.is-open .gs-pw__open{display:block}
  .gs-pw__verse{margin:30px auto 0!important;max-width:30em;font-family:var(--gs-display);font-style:italic;font-size:1.12rem;line-height:1.5;color:var(--gs-parch-dim);border-top:1px solid var(--gs-line);padding-top:20px}
  .gs-pw__verse cite{display:block;margin-top:6px;font-style:normal;font-family:var(--gs-caps);letter-spacing:.08em;font-size:.88rem;color:var(--gs-bronze)}
  .gs-pw__news{margin:30px auto 0;max-width:420px}
  .gs-pw__news label.gs-pw__label{display:block;font-family:var(--gs-caps);letter-spacing:.08em;color:var(--gs-gold-hi);margin-bottom:10px}
  .gs-pw__row{display:flex;gap:8px}
  .gs-pw__row .gs-input{background:rgba(12,9,7,.6);flex:1;min-width:0}
  .gs-pw__row .gs-btn{flex:none;white-space:nowrap;padding-left:18px;padding-right:18px}
  @media (max-width:420px){.gs-pw__sep{display:none}.gs-pw__unit{min-width:0;flex:1}.gs-pw__cd{gap:6px;max-width:320px;margin-left:auto;margin-right:auto}}
  .gs-pw__msg{min-height:1.4em;margin-top:10px!important;font-style:italic}
  .gs-pw__msg.is-ok{color:var(--gs-gold-hi)}
  .gs-pw__msg.is-err{color:var(--gs-red-letter)}
  .gs-pw__foot{position:absolute;bottom:calc(18px + env(safe-area-inset-bottom,0px));left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:12px}
  .gs-pw__social{display:flex;gap:8px}
  .gs-pw__social a{display:inline-grid;place-items:center;width:40px;height:40px;border:1px solid var(--gs-line);border-radius:50%;color:var(--gs-parch)}
  .gs-pw__social a:hover{border-color:var(--gs-gold);color:var(--gs-gold-hi)}
  .gs-pw__social svg{width:18px;height:18px}
  .gs-pw__enter{background:none;border:0;color:var(--gs-parch-dim);font-family:var(--gs-caps);letter-spacing:.08em;font-size:.9rem;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
  .gs-pw__lock{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:20px;background:rgba(10,8,6,.9)}
  .gs-pw__lock[hidden]{display:none}
  .gs-pw__lockbox{width:100%;max-width:380px;background:var(--gs-umber-2);border:1px solid var(--gs-gold);padding:28px 22px;position:relative}
  .gs-pw__lockbox h2{font-family:var(--gs-display);font-size:1.8rem;margin-bottom:16px!important}
  .gs-pw__close{position:absolute;top:6px;right:8px;background:none;border:0;color:var(--gs-parch);font-size:1.7rem;line-height:1;padding:6px 10px;cursor:pointer}
  @media (prefers-reduced-motion:reduce){.gs-pw__glow{animation:none}.gs-pw__inner{animation:none;opacity:1}}
</style>

<div class="gs gs-pw" data-gs-pw data-launch="{{ launch | escape }}">
  <div class="gs-pw__bg">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1920 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 750, 1080, 1500, 1920', sizes: '100vw', alt: '' }}
    {%- endif -%}
  </div>
  <div class="gs-pw__glow" aria-hidden="true"></div>

  <div class="gs-pw__logo">
    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'eager', widths: '200, 300, 600' }}
    {%- else -%}
      <span class="gs-pw__word">{{ shop.name | escape }}</span>
    {%- endif -%}
  </div>

  <main class="gs-pw__inner" id="MainContent">
    {%- if s.eyebrow != blank -%}<p class="gs-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ s.heading | escape }}</h1>
    {%- if s.tagline != blank -%}<p class="gs-pw__tag">{{ s.tagline | escape }}</p>{%- endif -%}

    {%- if s.show_countdown -%}
      <div class="gs-pw__cd" role="timer" aria-live="off" aria-label="Time until the drop">
        <div class="gs-pw__unit"><span class="gs-pw__num" data-u="d">--</span><span class="gs-pw__lbl">Days</span></div>
        <span class="gs-pw__sep" aria-hidden="true">·</span>
        <div class="gs-pw__unit"><span class="gs-pw__num" data-u="h">--</span><span class="gs-pw__lbl">Hours</span></div>
        <span class="gs-pw__sep" aria-hidden="true">·</span>
        <div class="gs-pw__unit"><span class="gs-pw__num" data-u="m">--</span><span class="gs-pw__lbl">Min</span></div>
        <span class="gs-pw__sep" aria-hidden="true">·</span>
        <div class="gs-pw__unit"><span class="gs-pw__num" data-u="s">--</span><span class="gs-pw__lbl">Sec</span></div>
      </div>
      {%- if s.when_label != blank -%}<p class="gs-pw__when">{{ s.when_label | escape }}</p>{%- endif -%}
      <div class="gs-pw__open">
        <p class="gs-pw__tag" style="margin-bottom:18px!important">{{ s.open_message | escape }}</p>
        <a class="gs-btn" href="{{ routes.root_url }}">{{ s.open_button | escape }}</a>
      </div>
    {%- endif -%}

    {%- if s.show_newsletter -%}
      <form class="gs-pw__news" data-gs-pw-news novalidate>
        <label class="gs-pw__label" for="gs-pw-email">{{ s.news_label | escape }}</label>
        <div class="gs-pw__row">
          <input class="gs-input" id="gs-pw-email" type="email" name="email" placeholder="{{ s.news_placeholder | escape }}" autocomplete="email" required>
          <button class="gs-btn gs-btn--red" type="submit">{{ s.news_button | escape }}</button>
        </div>
        <p class="gs-pw__msg" data-gs-pw-msg role="status" aria-live="polite"></p>
      </form>
    {%- endif -%}

    {%- if s.verse != blank -%}
      <blockquote class="gs-pw__verse">{{ s.verse | escape }}{% if s.verse_ref != blank %}<cite>{{ s.verse_ref | escape }}</cite>{% endif %}</blockquote>
    {%- endif -%}
  </main>

  <div class="gs-pw__foot">
    <div class="gs-pw__social">
      {%- if s.instagram != blank -%}
        <a href="{{ s.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor"/></svg></a>
      {%- endif -%}
      {%- if s.tiktok != blank -%}
        <a href="{{ s.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.8 5.8 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"/></svg></a>
      {%- endif -%}
    </div>
    <button type="button" class="gs-pw__enter" data-gs-pw-lock-open aria-controls="gs-pw-lock">{{ s.enter_label | escape }}</button>
  </div>

  {%- comment -%} Store password form: only needed by you and anyone you give the password to {%- endcomment -%}
  <div class="gs-pw__lock" id="gs-pw-lock" role="dialog" aria-modal="true" aria-labelledby="gs-pw-lock-title" hidden>
    <div class="gs-pw__lockbox">
      <button type="button" class="gs-pw__close" data-gs-pw-lock-close aria-label="Close">×</button>
      <h2 id="gs-pw-lock-title">{{ s.enter_title | escape }}</h2>
      {%- form 'storefront_password', class: 'gs-pw__pwform' -%}
        <label class="gs-visually-hidden" for="gs-pw-password">Password</label>
        <div class="gs-pw__row">
          <input class="gs-input" id="gs-pw-password" type="password" name="password" placeholder="Password" autocomplete="current-password" required>
          <button class="gs-btn" type="submit">Enter</button>
        </div>
        {%- if form.errors -%}
          <p class="gs-pw__msg is-err" data-gs-pw-has-error>That password isn't right. Try again.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<script>
(function(){
  var root=document.querySelector('[data-gs-pw]');if(!root)return;

  /* countdown */
  var launch=Date.parse(root.getAttribute('data-launch'));
  var nums={};root.querySelectorAll('.gs-pw__num').forEach(function(n){nums[n.getAttribute('data-u')]=n});
  function pad(n){return (n<10?'0':'')+n}
  function tick(){
    if(isNaN(launch)||!nums.d)return;
    var left=Math.max(0,launch-Date.now());
    if(left===0){root.classList.add('is-open');return}
    var s=Math.floor(left/1000);
    nums.d.textContent=pad(Math.floor(s/86400));nums.h.textContent=pad(Math.floor(s%86400/3600));
    nums.m.textContent=pad(Math.floor(s%3600/60));nums.s.textContent=pad(s%60);
    setTimeout(tick,1000-(Date.now()%1000));
  }
  tick();

  /* email signup straight into the Klaviyo list */
  var form=root.querySelector('[data-gs-pw-news]');
  if(form){
    var msg=form.querySelector('[data-gs-pw-msg]'),btn=form.querySelector('button');
    var say=function(t,ok){msg.textContent=t;msg.className='gs-pw__msg '+(ok?'is-ok':'is-err')};
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var email=form.email.value.trim();
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){say('Please enter a valid email.',false);return}
      btn.disabled=true;
      fetch('https://a.klaviyo.com/client/subscriptions/?company_id={{ s.klaviyo_key | url_encode }}',{
        method:'POST',
        headers:{'Content-Type':'application/vnd.api+json',revision:'2024-10-15'},
        body:JSON.stringify({data:{type:'subscription',attributes:{custom_source:{{ s.news_source | json }},profile:{data:{type:'profile',attributes:{email:email}}}},relationships:{list:{data:{type:'list',id:{{ s.klaviyo_list | json }}}}}}})
      }).then(function(r){
        if(!r.ok)throw new Error();
        say({{ s.news_success | json }},true);form.email.value='';
      }).catch(function(){say('Something went wrong. Please try again.',false)})
        .then(function(){btn.disabled=false});
    });
  }

  /* password box */
  var lock=document.getElementById('gs-pw-lock'),opener=root.querySelector('[data-gs-pw-lock-open]');
  function openLock(){lock.hidden=false;var i=lock.querySelector('input[type=password]');if(i)i.focus()}
  function closeLock(){lock.hidden=true;opener.focus()}
  opener.addEventListener('click',openLock);
  lock.addEventListener('click',function(e){if(e.target===lock||e.target.closest('[data-gs-pw-lock-close]'))closeLock()});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!lock.hidden)closeLock()});
  if(lock.querySelector('[data-gs-pw-has-error]'))openLock();
})();
</script>

{% schema %}
{
  "name": "GS Password page",
  "class": "gs-password-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background painting" },
    { "type": "range", "id": "overlay", "label": "Darken painting", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_h", "label": "Logo height", "min": 20, "max": 70, "step": 2, "unit": "px", "default": 34 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The next drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Book of Matthew" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Five pieces. Five moments. One story." },
    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "text", "id": "launch_date", "label": "Drop date (YYYY-MM-DD)", "default": "2026-09-27" },
    { "type": "text", "id": "launch_time", "label": "Drop time (24-hour, HH:MM)", "default": "17:00" },
    { "type": "select", "id": "utc_offset", "label": "Time zone", "default": "-07:00", "options": [
      { "value": "-07:00", "label": "Pacific (PDT)" },
      { "value": "-06:00", "label": "Mountain (MDT)" },
      { "value": "-05:00", "label": "Central (CDT)" },
      { "value": "-04:00", "label": "Eastern (EDT)" }
    ] },
    { "type": "text", "id": "when_label", "label": "Text under the countdown", "default": "Sunday, Sept 27 · 5 PM PT" },
    { "type": "text", "id": "open_message", "label": "Message when the countdown ends", "default": "The book is open." },
    { "type": "text", "id": "open_button", "label": "Button when the countdown ends", "default": "Enter" },
    { "type": "header", "content": "Email signup (Klaviyo)" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "news_label", "label": "Label", "default": "Get notified the moment it opens" },
    { "type": "text", "id": "news_placeholder", "label": "Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "news_button", "label": "Button", "default": "Notify me" },
    { "type": "text", "id": "news_success", "label": "Success message", "default": "You're on the list. Check your inbox to confirm." },
    { "type": "text", "id": "klaviyo_key", "label": "Klaviyo public site key", "default": "UAqA5m", "info": "Klaviyo → Settings → Account → API keys → Public API key (6 characters)." },
    { "type": "text", "id": "klaviyo_list", "label": "Klaviyo list ID", "default": "SAHbHz", "info": "The list people join. SAHbHz is your \"Email List\"." },
    { "type": "text", "id": "news_source", "label": "Signup source name (shows in Klaviyo)", "default": "Password page · Book of Matthew" },
    { "type": "header", "content": "Verse + social" },
    { "type": "textarea", "id": "verse", "label": "Verse (KJV)", "default": "Thy word is a lamp unto my feet, and a light unto my path." },
    { "type": "text", "id": "verse_ref", "label": "Verse reference", "default": "Psalm 119:105" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "header", "content": "Password entry" },
    { "type": "text", "id": "enter_label", "label": "Link at the bottom", "default": "Enter with password" },
    { "type": "text", "id": "enter_title", "label": "Password box title", "default": "Enter the store" }
  ]
}
{% endschema %}
