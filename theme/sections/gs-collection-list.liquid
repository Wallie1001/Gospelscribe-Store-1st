<style>
  #gs-cl-{{ section.id }} .gs-cl{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  #gs-cl-{{ section.id }} .gs-cl::-webkit-scrollbar{display:none}
  #gs-cl-{{ section.id }} .gs-cl--center{justify-content:center}
  #gs-cl-{{ section.id }} .gs-cl a{flex:0 0 auto;scroll-snap-align:start;text-align:center;text-decoration:none;color:inherit}
  #gs-cl-{{ section.id }} .gs-cl__img{overflow:hidden;background:var(--gs-umber-2);border:1px solid var(--gs-gold);box-shadow:0 0 0 4px var(--gs-umber),0 0 0 5px var(--gs-line)}
  #gs-cl-{{ section.id }} .gs-cl--circle .gs-cl__img{width:96px;height:96px;border-radius:50%}
  #gs-cl-{{ section.id }} .gs-cl--arch .gs-cl__img{width:150px;height:200px;border-radius:80px 80px 2px 2px}
  @media (min-width:750px){#gs-cl-{{ section.id }} .gs-cl--circle .gs-cl__img{width:120px;height:120px}#gs-cl-{{ section.id }} .gs-cl--arch .gs-cl__img{width:200px;height:260px;border-radius:110px 110px 2px 2px}}
  #gs-cl-{{ section.id }} .gs-cl__img img{width:100%;height:100%;object-fit:cover}
  #gs-cl-{{ section.id }} .gs-cl a:hover .gs-cl__img{border-color:var(--gs-gold-hi)}
  #gs-cl-{{ section.id }} .gs-cl__label{display:block;margin-top:12px;font-family:var(--gs-caps);letter-spacing:.08em;font-size:1rem}
</style>
{%- liquid
  assign n = section.blocks.size
  assign center = false
  if n < 5
    assign center = true
  endif
-%}
<section class="gs gs-section gs-section--tight gs-bg-{{ section.settings.background }}" id="gs-cl-{{ section.id }}">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="gs-head gs-head--center"><h2 class="gs-title">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="gs-cl gs-cl--{{ section.settings.shape }}{% if center %} gs-cl--center{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign img = block.settings.image
          if img == blank and col != blank
            assign img = col.featured_image
            if img == blank
              assign img = col.products.first.featured_image
            endif
          endif
          assign label = block.settings.label
          if label == blank and col != blank
            assign label = col.title
          endif
        -%}
        <a href="{% if col != blank %}{{ col.url }}{% else %}#{% endif %}" {{ block.shopify_attributes }}>
          <div class="gs-cl__img">
            {%- if img != blank -%}
              {{ img | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 300, 500', sizes: '200px', alt: '' }}
            {%- else -%}
              <div class="gs-placeholder">✦</div>
            {%- endif -%}
          </div>
          <span class="gs-cl__label">{{ label | default: 'Collection' | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GS Collection list",
  "class": "gs-collection-list-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "shape", "label": "Shape", "default": "circle", "options": [
      { "value": "circle", "label": "Circles" },
      { "value": "arch", "label": "Arches (like the Testament doors)" }
    ] },
    { "type": "select", "id": "background", "label": "Background", "default": "umber", "options": [
      { "value": "umber", "label": "Umber (dark)" },
      { "value": "umber-2", "label": "Umber, lighter" },
      { "value": "parch", "label": "Parchment (light)" }
    ] }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Leave empty to use the collection's image." },
      { "type": "text", "id": "label", "label": "Label (optional)" }
    ] }
  ],
  "presets": [ { "name": "GS Collection list", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] } ]
}
{% endschema %}
