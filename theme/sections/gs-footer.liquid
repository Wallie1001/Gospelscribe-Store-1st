<style>
  .gs-foot{background:var(--gs-umber);border-top:1px solid var(--gs-line);padding:56px 0 calc(28px + env(safe-area-inset-bottom,0px))}
  .gs-foot__top{display:grid;gap:40px}
  @media (min-width:750px){.gs-foot__top{grid-template-columns:1.4fr repeat(var(--gs-foot-cols,2),1fr);gap:48px}}
  .gs-foot__brand img{height:{{ section.settings.logo_h }}px;width:auto}
  .gs-foot__word{font-family:var(--gs-display);font-size:2rem}
  .gs-foot__tag{font-family:var(--gs-display);font-style:italic;color:var(--gs-gold-hi);font-size:1.15rem;margin-top:10px!important}
  .gs-foot__verse{margin-top:18px!important;color:var(--gs-parch-dim);border-left:1px solid var(--gs-crimson);padding-left:12px;font-style:italic;max-width:30em}
  .gs-foot h3{font-family:var(--gs-caps)!important;letter-spacing:.1em;color:var(--gs-gold-hi);font-size:1rem!important;margin-bottom:14px!important}
  .gs-foot ul{list-style:none;margin:0;padding:0}
  .gs-foot li a{display:inline-block;padding:6px 0;color:var(--gs-parch);text-decoration:none}
  .gs-foot li a:hover{color:var(--gs-gold-hi)}
  .gs-foot__news{margin-top:44px;padding:28px 0;border-top:1px solid var(--gs-line);border-bottom:1px solid var(--gs-line);display:grid;gap:16px}
  @media (min-width:750px){.gs-foot__news{grid-template-columns:1fr 1fr;align-items:center}}
  .gs-foot__news form{display:flex;gap:8px}
  .gs-foot__bottom{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;margin-top:28px;color:var(--gs-parch-dim);font-size:.92rem}
  .gs-foot__social{display:flex;gap:6px}
  .gs-foot__social a{display:inline-grid;place-items:center;width:40px;height:40px;border:1px solid var(--gs-line);border-radius:50%;color:var(--gs-parch)}
  .gs-foot__social a:hover{border-color:var(--gs-gold);color:var(--gs-gold-hi)}
  .gs-foot__social svg{width:18px;height:18px}
  .gs-foot__pay{display:flex;flex-wrap:wrap;gap:6px}
  .gs-foot__pay svg{height:22px;width:auto}
</style>

{%- liquid
  assign menu_count = 0
  for block in section.blocks
    if block.type == 'menu'
      assign menu_count = menu_count | plus: 1
    endif
  endfor
-%}
<footer class="gs gs-foot" style="--gs-foot-cols: {{ menu_count | at_least: 1 }}">
  <div class="gs-wrap">
    <div class="gs-foot__top">
      <div class="gs-foot__brand">
        <a href="{{ routes.root_url }}" style="text-decoration:none;display:inline-block">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 500 | image_tag: alt: shop.name, loading: 'lazy', widths: '200, 300, 500' }}
          {%- else -%}
            <span class="gs-foot__word">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}<p class="gs-foot__tag">{{ section.settings.tagline | escape }}</p>{%- endif -%}
        {%- if section.settings.verse != blank -%}<p class="gs-foot__verse">{{ section.settings.verse | escape }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading | default: block.settings.menu.title | escape }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="gs-foot__news">
        <div>
          <p class="gs-title" style="font-size:1.7rem">{{ section.settings.news_heading | escape }}</p>
          {%- if section.settings.news_text != blank -%}<p class="gs-muted" style="margin-top:6px">{{ section.settings.news_text | escape }}</p>{%- endif -%}
        </div>
        <div>
          {%- if section.settings.klaviyo_embed != blank -%}
            {{ section.settings.klaviyo_embed }}
          {%- else -%}
            {%- form 'customer', id: 'gs-foot-news' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="gs-link" role="status">You're on the list. Welcome.</p>
              {%- else -%}
                <label class="gs-visually-hidden" for="gs-foot-email">Email</label>
                <input class="gs-input" id="gs-foot-email" type="email" name="contact[email]" placeholder="your@email.com" required autocomplete="email">
                <button class="gs-btn" type="submit">Join</button>
              {%- endif -%}
            {%- endform -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="gs-foot__bottom">
      <div class="gs-foot__social">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor"/></svg></a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.8 5.8 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"/></svg></a>
        {%- endif -%}
        {%- if section.settings.youtube != blank -%}
          <a href="{{ section.settings.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg></a>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment -%}
        <div class="gs-foot__pay" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
        </div>
      {%- endif -%}
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.copyright_extra != blank %} · {{ section.settings.copyright_extra | escape }}{% endif %}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "GS Footer",
  "class": "gs-footer-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_h", "label": "Logo height", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Wear the Word" },
    { "type": "text", "id": "verse", "label": "Verse", "default": "Go ye therefore, and teach all nations. Matthew 28:19" },
    { "type": "header", "content": "Email signup" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "news_heading", "label": "Heading", "default": "Join the movement" },
    { "type": "text", "id": "news_text", "label": "Text", "default": "Drop alerts and early access, straight to your inbox." },
    { "type": "textarea", "id": "klaviyo_embed", "label": "Klaviyo form code (optional)", "info": "Paste your Klaviyo embed code, like <div class=\"klaviyo-form-XXXX\"></div>. Leave empty to use Shopify's own signup form." },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright_extra", "label": "Extra text after copyright" }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "limit": 4, "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ] }
  ],
  "presets": [ { "name": "GS Footer" } ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
