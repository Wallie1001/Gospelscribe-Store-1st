{%- liquid
  assign threshold = section.settings.free_ship | times: 100
  assign left = threshold | minus: cart.total_price
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  endif
-%}
<style>
  .gs-cart{padding:48px 0 88px}
  .gs-cart__grid{display:grid;gap:36px}
  @media (min-width:990px){.gs-cart__grid{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:56px;align-items:start}}
  .gs-cart__item{display:grid;grid-template-columns:92px 1fr auto;gap:16px;padding:18px 0;border-bottom:1px solid var(--gs-line);align-items:start}
  .gs-cart__img{aspect-ratio:3/4;background:#fff;overflow:hidden}
  .gs-cart__img img{width:100%;height:100%;object-fit:cover}
  .gs-cart__name{font-family:var(--gs-display);font-size:1.2rem;line-height:1.2;text-decoration:none;color:var(--gs-parch)}
  .gs-cart__meta{color:var(--gs-parch-dim);font-size:.95rem;margin-top:4px!important}
  .gs-qty{display:inline-flex;align-items:center;border:1px solid rgba(232,220,196,.3);margin-top:12px}
  .gs-qty button{width:38px;height:38px;background:none;border:0;color:var(--gs-parch);font-size:1.1rem}
  .gs-qty input{width:40px;height:38px;text-align:center;background:none;border:0;color:var(--gs-parch);font-family:var(--gs-body);font-size:1rem;-moz-appearance:textfield}
  .gs-qty input::-webkit-inner-spin-button{-webkit-appearance:none}
  .gs-cart__remove{display:inline-block;margin-left:14px;color:var(--gs-parch-dim);font-size:.9rem}
  .gs-cart__price{font-family:var(--gs-caps);letter-spacing:.05em;text-align:right}
  .gs-cart__sum{background:var(--gs-umber-2);border:1px solid var(--gs-line);padding:24px}
  .gs-cart__row{display:flex;justify-content:space-between;padding:8px 0;font-family:var(--gs-caps);letter-spacing:.05em}
  .gs-cart__row--total{font-size:1.25rem;border-top:1px solid var(--gs-line);margin-top:8px;padding-top:14px}
  .gs-ship{margin-bottom:18px}
  .gs-ship p{font-family:var(--gs-caps);letter-spacing:.05em;color:var(--gs-gold-hi);font-size:.95rem}
  .gs-ship__bar{height:4px;background:rgba(232,220,196,.12);margin-top:8px}
  .gs-ship__bar span{display:block;height:100%;background:var(--gs-gold)}
  .gs-cart__note{width:100%;min-height:80px;margin-top:6px}
  .gs-cart .additional-checkout-buttons{margin-top:10px}
</style>

<section class="gs gs-cart">
  <div class="gs-wrap">
    <div class="gs-head gs-head--center">
      <p class="gs-eyebrow">Gospelscribe</p>
      <h1 class="gs-title gs-title--xl">Your bag</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="gs-cart-form" novalidate>
        <div class="gs-cart__grid">
          <div>
            {%- for item in cart.items -%}
              <div class="gs-cart__item">
                <a class="gs-cart__img" href="{{ item.url }}">
                  {%- if item.image != blank -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
                </a>
                <div>
                  <a class="gs-cart__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="gs-cart__meta">{{ item.variant.title | escape }}</p>{%- endunless -%}
                  {%- for p in item.properties -%}{%- unless p.last == blank or p.first.first == '_' -%}<p class="gs-cart__meta">{{ p.first }}: {{ p.last }}</p>{%- endunless -%}{%- endfor -%}
                  <div>
                    <div class="gs-qty">
                      <button type="button" data-gs-step="-1" aria-label="One less">−</button>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
                      <button type="button" data-gs-step="1" aria-label="One more">+</button>
                    </div>
                    <a class="gs-cart__remove" href="{{ item.url_to_remove }}">Remove</a>
                  </div>
                </div>
                <div class="gs-cart__price">
                  {{ item.final_line_price | money }}
                  {%- if item.original_line_price > item.final_line_price -%}<br><s class="gs-muted">{{ item.original_line_price | money }}</s>{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
            <noscript><button class="gs-btn" type="submit" name="update" style="margin-top:16px">Update bag</button></noscript>
          </div>

          <div class="gs-cart__sum">
            {%- if threshold > 0 -%}
              <div class="gs-ship">
                {%- if left > 0 -%}
                  <p>You're {{ left | money }} away from free shipping</p>
                {%- else -%}
                  <p>Free shipping unlocked ✦</p>
                {%- endif -%}
                <div class="gs-ship__bar"><span style="width:{{ pct }}%"></span></div>
              </div>
            {%- endif -%}
            <div class="gs-cart__row"><span>Subtotal</span><span>{{ cart.items_subtotal_price | money }}</span></div>
            {%- for d in cart.cart_level_discount_applications -%}
              <div class="gs-cart__row"><span>{{ d.title | escape }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            <div class="gs-cart__row gs-cart__row--total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
            <p class="gs-muted" style="font-size:.92rem;margin:6px 0 18px">Shipping and taxes are calculated at checkout.</p>
            {%- if section.settings.show_note -%}
              <label class="gs-opt-label" for="gs-cart-note">Order note</label>
              <textarea class="gs-input gs-cart__note" id="gs-cart-note" name="note">{{ cart.note }}</textarea>
            {%- endif -%}
            <button class="gs-btn gs-btn--red gs-btn--block" type="submit" name="checkout" style="margin-top:16px">Checkout</button>
            {%- if additional_checkout_buttons and section.settings.show_express -%}
              <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
            <a class="gs-link" href="{{ routes.all_products_collection_url }}" style="display:inline-block;margin-top:18px">Keep shopping</a>
          </div>
        </div>
      </form>
    {%- else -%}
      <div style="text-align:center;padding:24px 0 40px">
        <p class="gs-sub">Your bag is empty.</p>
        <a class="gs-btn" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" style="margin-top:24px">{{ section.settings.empty_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var f=document.getElementById('gs-cart-form');if(!f||f.getAttribute('data-ready'))return;f.setAttribute('data-ready','1');
  var t;
  function submitSoon(){clearTimeout(t);t=setTimeout(function(){f.submit()},450)}
  f.addEventListener('click',function(e){
    var b=e.target.closest('[data-gs-step]');if(!b)return;
    var input=b.parentNode.querySelector('input');
    input.value=Math.max(0,(parseInt(input.value,10)||0)+parseInt(b.getAttribute('data-gs-step'),10));
    submitSoon();
  });
  f.addEventListener('change',function(e){if(e.target.name==='updates[]')submitSoon()});
})();
</script>

{% schema %}
{
  "name": "GS Cart page",
  "class": "gs-main-cart-section",
  "settings": [
    { "type": "range", "id": "free_ship", "label": "Free shipping over", "min": 0, "max": 300, "step": 5, "unit": "$", "default": 125, "info": "Only shows the progress bar. Set the real free shipping rule in Settings → Shipping. 0 hides the bar." },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons (Shop Pay, Apple Pay…)", "default": true },
    { "type": "text", "id": "empty_label", "label": "Empty bag button", "default": "Start shopping" },
    { "type": "url", "id": "empty_link", "label": "Empty bag button link" }
  ]
}
{% endschema %}
