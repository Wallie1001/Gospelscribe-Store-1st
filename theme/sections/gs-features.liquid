<style>
  #gs-ft-{{ section.id }} .gs-ft{display:grid;grid-template-columns:repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }},minmax(0,1fr));gap:12px}
  @media (max-width:749px){#gs-ft-{{ section.id }} .gs-ft{grid-template-columns:repeat({{ section.blocks.size | at_most: 3 | at_least: 1 }},minmax(0,1fr))}}
  #gs-ft-{{ section.id }} .gs-ft__item{text-align:center;padding:24px 10px;border:1px solid var(--gs-line);background:rgba(0,0,0,.12);text-decoration:none;color:inherit;display:block}
  #gs-ft-{{ section.id }} a.gs-ft__item:hover{border-color:var(--gs-gold)}
  #gs-ft-{{ section.id }} .gs-ft__icon{width:48px;height:48px;margin:0 auto 12px;display:grid;place-items:center;color:var(--gs-gold-hi)}
  #gs-ft-{{ section.id }} .gs-ft__icon img{width:48px;height:48px;object-fit:contain}
  #gs-ft-{{ section.id }} .gs-ft__icon svg{width:34px;height:34px}
  #gs-ft-{{ section.id }} .gs-ft__title{font-family:var(--gs-caps);letter-spacing:.08em;font-size:.98rem}
  #gs-ft-{{ section.id }} .gs-ft__text{margin-top:6px!important;color:var(--gs-parch-dim);font-size:.95rem}
  @media (max-width:749px){#gs-ft-{{ section.id }} .gs-ft__title{font-size:.82rem}#gs-ft-{{ section.id }} .gs-ft__item{padding:18px 6px}}
</style>
<section class="gs gs-section gs-section--tight gs-bg-{{ section.settings.background }}" id="gs-ft-{{ section.id }}">
  <div class="gs-wrap">
    {%- if section.settings.heading != blank -%}<div class="gs-head gs-head--center"><h2 class="gs-title">{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
    <div class="gs-ft">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a class="gs-ft__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<div class="gs-ft__item" {{ block.shopify_attributes }}>{%- endif -%}
          <div class="gs-ft__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'book' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5zM12 6.5v13"/></svg>
                {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/></svg>
                {%- when 'cross' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 2.5v19M6.5 8h11"/></svg>
                {%- when 'lamp' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 3c1.5 2 2.2 3.3 2.2 4.5a2.2 2.2 0 0 1-4.4 0C9.8 6.3 10.5 5 12 3z"/><path d="M4 14c2 3 5 4 8 4s6-1 8-4H4zM9 18l-1 3h8l-1-3"/></svg>
                {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 3l2.2 6.3H21l-5.4 4 2 6.4L12 15.8 6.4 19.7l2-6.4-5.4-4h6.8z"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <p class="gs-ft__title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}<p class="gs-ft__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GS Features",
  "class": "gs-features-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "background", "label": "Background", "default": "umber", "options": [
      { "value": "umber", "label": "Umber (dark)" },
      { "value": "umber-2", "label": "Umber, lighter" },
      { "value": "parch", "label": "Parchment (light)" }
    ] }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "star", "options": [
        { "value": "book", "label": "Open book" }, { "value": "heart", "label": "Heart" }, { "value": "cross", "label": "Cross" },
        { "value": "lamp", "label": "Oil lamp" }, { "value": "truck", "label": "Shipping" }, { "value": "star", "label": "Star" }
      ] },
      { "type": "image_picker", "id": "image", "label": "Custom icon image (optional)" },
      { "type": "text", "id": "title", "label": "Title", "default": "Spread His Word" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "GS Features", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] } ]
}
{% endschema %}
