{%- if section.blocks.size > 0 -%}
<style>
  .gs-ann{background:var(--gs-umber);border-bottom:1px solid var(--gs-line);overflow:hidden;white-space:nowrap}
  .gs-ann__track{display:flex;width:max-content;animation:gs-ann-scroll var(--gs-ann-speed,30s) linear infinite}
  .gs-ann--static .gs-ann__track{animation:none;width:100%;justify-content:center}
  .gs-ann__item{display:inline-flex;align-items:center;gap:22px;padding:9px 0 9px 22px;font-family:var(--gs-caps);font-size:.92rem;letter-spacing:.08em;color:var(--gs-gold-hi)}
  .gs-ann__item a{color:inherit;text-decoration:none}
  .gs-ann__item::after{content:"✦";font-size:.6rem;color:var(--gs-bronze)}
  .gs-ann--static .gs-ann__item{padding-right:22px}
  .gs-ann--static .gs-ann__item::after{display:none}
  @keyframes gs-ann-scroll{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.gs-ann__track{animation:none}}
</style>
{%- liquid
  assign moving = false
  if section.settings.style == 'marquee'
    assign moving = true
  endif
  assign reps = 1
  if moving
    assign reps = 6
  endif
-%}
<div class="gs gs-ann{% unless moving %} gs-ann--static{% endunless %}" style="--gs-ann-speed: {{ section.settings.speed }}s" role="region" aria-label="Announcement">
  <div class="gs-ann__track">
    {%- for i in (1..reps) -%}
      {%- for block in section.blocks -%}
        <span class="gs-ann__item" {{ block.shopify_attributes }}{% if i > 1 %} aria-hidden="true"{% endif %}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}"{% if i > 1 %} tabindex="-1"{% endif %}>{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </span>
      {%- endfor -%}
      {%- unless moving -%}{%- break -%}{%- endunless -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "GS Announcement",
  "class": "gs-announcement-section",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "marquee", "options": [
      { "value": "marquee", "label": "Scrolling" },
      { "value": "static", "label": "Still (centered)" }
    ] },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds per loop)", "min": 10, "max": 80, "step": 5, "default": 35 }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $125" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "GS Announcement", "blocks": [ { "type": "message" } ] } ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
